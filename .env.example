# Porta do app
PORT=3000

# API de exercícios — mock local em mock-api/ durante o desenvolvimento.
# Produção (quando liberada): https://gymapi.kadu.tec.br/api/v1
EXERCISES_API_URL=http://localhost:3005/api/v1

# Parâmetro de busca (FULL TEXT). A API real usa "Search"; o mock aceita ambos.
EXERCISES_API_SEARCH_PARAM=Search

# Autenticação da API (o mock não exige). Ex.:
#   EXERCISES_API_AUTH_HEADER=Authorization
#   EXERCISES_API_AUTH_VALUE=Bearer SEU_TOKEN
EXERCISES_API_AUTH_HEADER=
EXERCISES_API_AUTH_VALUE=

# Timeout de cada chamada à API (ms)
EXERCISES_API_TIMEOUT_MS=5000

# TTL do cache em memória de listas/detalhes (ms)
EXERCISES_API_CACHE_TTL_MS=60000

# Detalhes consultados em paralelo ao montar grupos musculares
EXERCISES_API_CONCURRENCY=6

# Mock API
MOCK_API_PORT=3005
MOCK_API_LATENCY_MS=0
