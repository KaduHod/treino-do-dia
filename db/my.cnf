[mysqld]
# Unicode completo (nomes de exercícios com acentos, emoji etc.).
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# Datas em UTC, alinhadas ao ISO 8601 que o app já usa (createdAt/updatedAt).
default-time-zone = '+00:00'

# No compose os containers se resolvem pelo nome do serviço; evitar DNS reverso.
skip-name-resolve = 1

[client]
default-character-set = utf8mb4
