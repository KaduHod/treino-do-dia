<!DOCTYPE html>
<html lang="pt-BR" class="h-full" data-theme="terroso">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Treino do Dia — registro de treinos</title>
  <meta name="description" content="Registro minimalista de treinos diários com HTMX e Tailwind CSS." />
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />

  <script>
    // Aplica o tema salvo antes do primeiro paint (evita flash de tema errado).
    (function () {
      var themes = ['terroso', 'meia-noite', 'oceano', 'ameixa', 'carmim', 'noir'];
      try {
        var saved = localStorage.getItem('treino-theme');
        if (saved && themes.indexOf(saved) !== -1) {
          document.documentElement.dataset.theme = saved;
        }
      } catch (error) {
        /* localStorage indisponível: mantém o tema padrão */
      }
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    // Tokens semânticos: cada cor vem de uma variável CSS definida por tema em
    // <style>. O formato "rgb(var(--c-x) / <alpha-value>)" preserva opacidades
    // como bg-moss/90, border-sand/80 e ring-gold/30.
    const token = (name) => `rgb(var(--c-${name}) / <alpha-value>)`;

    tailwind.config = {
      theme: {
        extend: {
          colors: {
            cream: token('cream'),
            surface: token('surface'),
            ink: token('ink'),
            bark: token('bark'),
            moss: token('moss'),
            olive: token('olive'),
            sage: token('sage'),
            sand: token('sand'),
            gold: token('gold'),
            'on-primary': token('on-primary'),
            'primary-hover': token('primary-hover'),
            inverted: token('inverted'),
            'on-inverted': token('on-inverted')
          },
          fontFamily: {
            sans: ['Inter', 'ui-sans-serif', 'system-ui', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', 'sans-serif'],
            display: ['Fraunces', 'ui-serif', 'Georgia', 'Cambria', 'Times New Roman', 'serif']
          },
          boxShadow: {
            card: 'var(--shadow-card)',
            soft: 'var(--shadow-soft)'
          }
        }
      }
    };
  </script>
  <script src="https://unpkg.com/htmx.org@2.0.11/dist/htmx.min.js"></script>

  <style>
    /* ---------------------------------------------------------------------
       TEMAS
       Cada token é um trio RGB (permite /opacidade no Tailwind).
       Para criar um tema: copie um bloco, ajuste os canais RGB e registre o
       nome em views/index.ejs e public/js/app.js (THEMES).
       Papéis:
         cream         fundo da página e superfícies claras
         surface       fundo de cards/campos
         ink           texto principal (e superfícies invertidas no tema claro)
         bark          texto de apoio/links
         olive         texto secundário/rótulos
         moss          ação primária (botões, tile de volume)
         on-primary    texto sobre moss/inverted
         primary-hover hover da ação primária
         sage          acento neutro (chips, estado "no treino")
         sand          bordas e divisores
         gold          acento/destaque
         inverted      superfície escura (toast, botões discretos)
         on-inverted   texto sobre inverted
       --------------------------------------------------------------------- */
    :root,
    [data-theme='terroso'] {
      color-scheme: light;
      --c-cream: 255 255 234;
      --c-surface: 255 255 255;
      --c-ink: 38 29 18;
      --c-bark: 77 58 37;
      --c-moss: 49 64 26;
      --c-olive: 101 102 67;
      --c-sage: 161 166 128;
      --c-sand: 203 189 160;
      --c-gold: 191 154 84;
      --c-on-primary: 255 255 234;
      --c-primary-hover: 77 58 37;
      --c-inverted: 38 29 18;
      --c-on-inverted: 255 255 234;
      --shadow-card: 0 26px 50px -34px rgb(38 29 18 / 0.55);
      --shadow-soft: 0 10px 22px -18px rgb(38 29 18 / 0.65);
      --glow-gold: rgb(191 154 84 / 0.18);
      --glow-sage: rgb(161 166 128 / 0.24);
      --backdrop: rgb(38 29 18 / 0.58);
    }

    [data-theme='meia-noite'] {
      color-scheme: dark;
      --c-cream: 20 21 15;
      --c-surface: 30 32 23;
      --c-ink: 241 237 220;
      --c-bark: 214 200 171;
      --c-moss: 63 90 42;
      --c-olive: 167 167 141;
      --c-sage: 110 117 81;
      --c-sand: 59 62 46;
      --c-gold: 217 179 107;
      --c-on-primary: 247 244 230;
      --c-primary-hover: 76 107 51;
      --c-inverted: 237 233 216;
      --c-on-inverted: 26 27 19;
      --shadow-card: 0 26px 50px -34px rgb(0 0 0 / 0.7);
      --shadow-soft: 0 10px 22px -18px rgb(0 0 0 / 0.75);
      --glow-gold: rgb(217 179 107 / 0.1);
      --glow-sage: rgb(110 117 81 / 0.18);
      --backdrop: rgb(0 0 0 / 0.68);
    }

    [data-theme='oceano'] {
      color-scheme: light;
      --c-cream: 241 247 246;
      --c-surface: 255 255 255;
      --c-ink: 15 38 36;
      --c-bark: 31 66 62;
      --c-moss: 20 82 76;
      --c-olive: 78 107 102;
      --c-sage: 143 179 173;
      --c-sand: 191 214 210;
      --c-gold: 192 138 62;
      --c-on-primary: 244 251 249;
      --c-primary-hover: 12 59 54;
      --c-inverted: 15 38 36;
      --c-on-inverted: 241 247 246;
      --shadow-card: 0 26px 50px -34px rgb(15 38 36 / 0.5);
      --shadow-soft: 0 10px 22px -18px rgb(15 38 36 / 0.6);
      --glow-gold: rgb(192 138 62 / 0.16);
      --glow-sage: rgb(143 179 173 / 0.24);
      --backdrop: rgb(15 38 36 / 0.55);
    }

    [data-theme='ameixa'] {
      color-scheme: light;
      --c-cream: 251 244 241;
      --c-surface: 255 255 255;
      --c-ink: 43 26 32;
      --c-bark: 76 47 57;
      --c-moss: 90 42 58;
      --c-olive: 110 76 88;
      --c-sage: 185 154 164;
      --c-sand: 221 199 205;
      --c-gold: 185 130 70;
      --c-on-primary: 255 246 243;
      --c-primary-hover: 69 33 46;
      --c-inverted: 43 26 32;
      --c-on-inverted: 251 244 241;
      --shadow-card: 0 26px 50px -34px rgb(43 26 32 / 0.5);
      --shadow-soft: 0 10px 22px -18px rgb(43 26 32 / 0.6);
      --glow-gold: rgb(185 130 70 / 0.16);
      --glow-sage: rgb(185 154 164 / 0.22);
      --backdrop: rgb(43 26 32 / 0.55);
    }
    [data-theme='carmim'] {
      color-scheme: dark;
      --c-cream: 18 8 10;            /* fundo da página: preto avermelhado */
      --c-surface: 30 13 17;         /* cards/campos */
      --c-ink: 245 232 230;          /* texto principal (claro) */
      --c-bark: 214 178 176;         /* texto de apoio/links */
      --c-moss: 128 24 44;           /* ação primária: bordô */
      --c-olive: 168 130 130;        /* texto secundário/rótulos */
      --c-sage: 110 48 56;           /* acento neutro (chips, "no treino") */
      --c-sand: 70 30 36;            /* bordas e divisores */
      --c-gold: 226 54 62;           /* destaque: vermelho vivo */
      --c-on-primary: 255 240 238;   /* texto sobre bordô */
      --c-primary-hover: 168 32 56;  /* hover da ação primária */
      --c-inverted: 245 232 230;     /* superfície invertida (toast, botões discretos) */
      --c-on-inverted: 18 8 10;      /* texto sobre inverted */
      --shadow-card: 0 26px 50px -34px rgb(0 0 0 / 0.85);
      --shadow-soft: 0 10px 22px -18px rgb(0 0 0 / 0.9);
      --glow-gold: rgb(226 54 62 / 0.20);
      --glow-sage: rgb(128 24 44 / 0.30);
      --backdrop: rgb(0 0 0 / 0.70);
    }
    [data-theme='noir'] {
        color-scheme: dark;
        --c-cream: 8 8 8;              /* fundo da página: quase preto puro */
        --c-surface: 18 15 15;         /* cards/campos: preto levemente quente */
        --c-ink: 240 236 235;          /* texto principal */
        --c-bark: 200 190 189;         /* texto de apoio/links */
        --c-moss: 112 20 36;           /* ação primária: bordô */
        --c-olive: 150 138 138;        /* texto secundário/rótulos */
        --c-sage: 74 38 44;            /* acento neutro (chips, "no treino") */
        --c-sand: 42 31 33;            /* bordas e divisores */
        --c-gold: 216 40 52;           /* destaque: vermelho vivo */
        --c-on-primary: 255 240 238;   /* texto sobre bordô */
        --c-primary-hover: 152 28 48;  /* hover da ação primária */
        --c-inverted: 240 236 235;     /* superfície invertida (toast, botões discretos) */
        --c-on-inverted: 8 8 8;        /* texto sobre inverted */
        --shadow-card: 0 26px 50px -34px rgb(0 0 0 / 0.95);
        --shadow-soft: 0 10px 22px -18px rgb(0 0 0 / 1);
        --glow-gold: rgb(216 40 52 / 0.16);
        --glow-sage: rgb(112 20 36 / 0.26);
        --backdrop: rgb(0 0 0 / 0.80);
    }
    html { background-color: rgb(var(--c-cream)); }

    body {
      background-image:
        radial-gradient(70rem 45rem at 112% -12%, var(--glow-gold), transparent 62%),
        radial-gradient(55rem 34rem at -12% 2%, var(--glow-sage), transparent 58%);
      background-attachment: fixed;
    }

    ::selection { background: rgb(var(--c-gold) / 0.35); color: rgb(var(--c-ink)); }

    .thin-scrollbar { scrollbar-width: thin; scrollbar-color: rgb(var(--c-sand)) transparent; }
    .thin-scrollbar::-webkit-scrollbar { width: 8px; }
    .thin-scrollbar::-webkit-scrollbar-thumb { background: rgb(var(--c-sand)); border-radius: 9999px; }
    .thin-scrollbar::-webkit-scrollbar-thumb:hover { background: rgb(var(--c-sage)); }

    /* Sombra sutil usada nas linhas de treino. */
    .entry-row { box-shadow: 0 1px 0 rgb(var(--c-ink) / 0.04); }

    dialog { color: rgb(var(--c-ink)); }
    dialog::backdrop { background: var(--backdrop); backdrop-filter: blur(3px); }
    dialog[open] { animation: dialog-in 170ms ease-out; }
    @keyframes dialog-in {
      from { opacity: 0; transform: translateY(10px) scale(0.985); }
      to { opacity: 1; transform: none; }
    }

    input[type='date']::-webkit-calendar-picker-indicator { opacity: 0.55; cursor: pointer; }

    .htmx-indicator { opacity: 0; transition: opacity 150ms ease-in; }
    .htmx-request .htmx-indicator,
    .htmx-request.htmx-indicator { opacity: 1; }
  </style>
</head>
<body class="min-h-full bg-cream font-sans text-ink antialiased">
  <div class="h-1.5 w-full bg-gradient-to-r from-moss via-gold to-sand" aria-hidden="true"></div>

  <div class="mx-auto flex min-h-screen max-w-6xl flex-col px-4 py-6 sm:px-6 lg:px-8">
    <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
          <span
                  class="flex h-12 w-12 items-center justify-center rounded-2xl bg-moss shadow-soft ring-1 ring-gold/40"
                  aria-hidden="true"
                  >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="-14 0 100 100" fill="none" class="h-7 w-7">
                      <path d="M8 100V8H38A21 21 0 0 1 38 50H8M33 50L52 76" stroke-width="16" style="stroke: rgb(var(--c-ink))" />
                      <circle cx="64" cy="92" r="8" style="fill: rgb(var(--c-ink))" />
                  </svg>
          </span>
        <div>
          <p class="inline-flex rounded-full bg-gold/15 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.22em] text-bark ring-1 ring-gold/40">Diário de treino</p>
          <h1 class="font-display text-2xl font-semibold leading-tight tracking-tight text-ink">Treino do Dia</h1>
          <p class="text-xs text-olive">Registre exercícios, repetições e cargas — salvo automaticamente.</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 sm:justify-end" role="group" aria-label="Controles do dia">
        <div class="flex items-center gap-2" aria-label="Selecionar data">
          <button
            type="button"
            data-date-shift="-1"
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-sand bg-surface/80 text-lg leading-none text-bark shadow-soft transition hover:border-gold hover:text-moss focus:outline-none focus:ring-2 focus:ring-gold/40"
            aria-label="Dia anterior"
          >‹</button>

          <input
            id="day-date"
            name="date"
            type="date"
            value="<%= view.date %>"
            hx-get="/day"
            hx-target="#content"
            hx-swap="innerHTML"
            hx-trigger="change"
            hx-include="#filter-form"
            class="rounded-xl border border-sand bg-surface/80 px-3 py-2 text-sm font-semibold text-bark shadow-soft focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/30"
            aria-label="Data do treino"
          />

          <button
            type="button"
            data-date-shift="1"
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-sand bg-surface/80 text-lg leading-none text-bark shadow-soft transition hover:border-gold hover:text-moss focus:outline-none focus:ring-2 focus:ring-gold/40"
            aria-label="Próximo dia"
          >›</button>

          <button
            type="button"
            data-date-today
            class="rounded-xl bg-moss px-3.5 py-2 text-sm font-semibold text-on-primary shadow-soft ring-1 ring-gold/25 transition hover:bg-primary-hover focus:outline-none focus:ring-2 focus:ring-gold/50"
          >Hoje</button>
        </div>

        <label class="ml-auto inline-flex items-center sm:ml-0" for="theme-select">
          <span class="sr-only">Tema</span>
          <select
            id="theme-select"
            class="h-9 cursor-pointer rounded-xl border border-sand bg-surface/80 pl-3 pr-7 text-sm font-medium text-bark shadow-soft transition hover:border-gold focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/30"
            title="Tema da interface"
          >
            <option value="terroso">Terroso</option>
            <option value="meia-noite">Meia-noite</option>
            <option value="oceano">Oceano</option>
            <option value="ameixa">Ameixa</option>
            <option value="carmim">Carmim</option>
            <option value="noir">Noir</option>
          </select>
        </label>
      </div>
    </header>

    <main id="content" class="mt-6 flex-1">
      <%- include('partials/content', { view }) %>
    </main>

    <footer class="mt-8 flex flex-col gap-1 border-t border-sand/70 pt-4 text-[11px] text-olive sm:flex-row sm:items-center sm:justify-between">
      <p>
        API de exercícios:
        <code class="rounded-md bg-sand/25 px-1.5 py-0.5 font-medium text-bark"><%= apiBaseUrl %></code>
      </p>
      <p>Express · HTMX · Tailwind CSS · dados em <code class="rounded-md bg-sand/25 px-1.5 py-0.5 font-medium text-bark">data/workouts.json</code></p>
    </footer>
  </div>

  <dialog
    id="exercise-modal"
    aria-label="Detalhes do exercício"
    class="w-[min(46rem,92vw)] overflow-hidden rounded-3xl border border-sand/70 bg-cream p-0 text-left shadow-2xl"
  ></dialog>

  <dialog
    id="reference-modal"
    aria-label="Referência muscular"
    class="w-[min(52rem,94vw)] overflow-hidden rounded-3xl border border-sand/70 bg-cream p-0 text-left shadow-2xl"
  ></dialog>

  <div
    id="toast"
    role="status"
    class="pointer-events-none fixed bottom-4 right-4 z-50 hidden max-w-sm rounded-xl bg-inverted px-4 py-3 text-sm text-on-inverted shadow-lg ring-1 ring-gold/40"
  ></div>

  <script src="/js/app.js"></script>
</body>
</html>
