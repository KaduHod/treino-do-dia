<div id="exercise-list" class="px-3 pb-4 pt-3">
  <% if (view.catalogError) { %>
    <div class="rounded-2xl border border-rose-200 bg-rose-50 p-4">
      <p class="text-sm font-semibold text-rose-800">Não foi possível carregar os exercícios</p>
      <p class="mt-1 break-words text-xs text-rose-700"><%= view.catalogError %></p>
      <button
        type="button"
        class="mt-3 rounded-lg bg-rose-700 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-rose-800 focus:outline-none focus:ring-2 focus:ring-rose-300"
        hx-get="/exercises"
        hx-target="#exercise-list"
        hx-swap="outerHTML"
        hx-include="#filter-form"
        hx-indicator="#catalog-loading"
        hx-vals='js:{date: document.getElementById("day-date").value}'
      >Tentar novamente</button>
    </div>
  <% } else if (!view.exercises.length) { %>
    <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-sand bg-cream/70 px-4 py-10 text-center">
      <p class="text-2xl" aria-hidden="true">🔎</p>
      <p class="mt-2 font-display text-base font-semibold text-ink">Nenhum exercício encontrado</p>
      <p class="mt-1 max-w-xs text-xs text-olive">
        <% if (view.filters.search || view.filters.group) { %>
          Tente outro termo de busca ou remova o filtro de grupo muscular.
        <% } else { %>
          A API de exercícios não retornou nenhum item.
        <% } %>
      </p>
    </div>
  <% } else { %>
    <div class="thin-scrollbar max-h-[32rem] space-y-1 overflow-y-auto pr-1">
      <% view.exercises.forEach(function (exercise) { %>
        <%- include('exercise-item', { view, exercise }) %>
      <% }) %>
    </div>
  <% } %>

  <div class="mt-3 flex items-center justify-between gap-2 border-t border-sand/60 px-1 pt-3 text-[11px] text-olive">
    <span>
      <%= view.exercises.length %> exercício<%= view.exercises.length === 1 ? '' : 's' %>
      <% if (view.filters.group) { %>· grupo <span class="font-semibold text-bark"><%= view.filters.group %></span><% } %>
      <% if (view.filters.search) { %>· busca <span class="font-semibold text-bark">“<%= view.filters.search %>”</span><% } %>
    </span>
    <span>
      <button
        type="button"
        class="inline-flex items-center gap-1 rounded-full border border-sand bg-cream/80 px-3 py-1 text-[11px] font-semibold text-bark transition hover:border-gold hover:bg-white hover:text-moss focus:outline-none focus:ring-2 focus:ring-gold/40"
        hx-get="/reference"
        hx-target="#reference-modal"
        hx-swap="innerHTML"
      >Referência muscular</button>
    </span>
  </div>
</div>
