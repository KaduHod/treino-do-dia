<div class="max-h-[85vh] overflow-y-auto">
  <header class="flex items-start justify-between gap-4 border-b border-sand/60 bg-gradient-to-br from-cream/90 via-surface to-surface p-5">
    <div class="min-w-0">
      <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-olive">Referência da API</p>
      <h2 class="mt-1 font-display text-xl font-semibold leading-snug text-ink">Músculos, articulações e movimentos</h2>
      <p class="mt-1 text-xs text-olive">
        Dados dos endpoints <code class="rounded-md bg-sand/25 px-1 py-0.5 text-bark">/muscles/groups</code> +
        <code class="rounded-md bg-sand/25 px-1 py-0.5 text-bark">/muscles/portions</code>,
        <code class="rounded-md bg-sand/25 px-1 py-0.5 text-bark">/joints</code> e
        <code class="rounded-md bg-sand/25 px-1 py-0.5 text-bark">/movements</code>.
      </p>
    </div>
    <button
      type="button"
      data-modal-close
      class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-bark transition hover:bg-sand/30 hover:text-ink focus:outline-none focus:ring-2 focus:ring-gold/40"
      aria-label="Fechar referência"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
        <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
      </svg>
    </button>
  </header>

  <% if (error) { %>
    <div class="bg-surface/70 p-5">
      <p class="text-sm font-semibold text-rose-800">Não foi possível carregar a referência muscular</p>
      <p class="mt-2 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-700"><%= error %></p>
    </div>
  <% } else { %>
    <div class="space-y-6 bg-surface/70 p-5">
      <section>
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="text-[10px] font-semibold uppercase tracking-[0.16em] text-olive">Grupos musculares</h3>
          <p class="text-[11px] text-olive">
            <%= reference.groups.length %> grupos · <%= reference.portionCount %> porções
          </p>
        </div>

        <div class="mt-2 grid gap-2 sm:grid-cols-2">
          <% reference.groups.forEach(function (group) { %>
            <details class="rounded-2xl border border-sand/70 bg-surface px-3 py-2 transition open:border-gold/50 open:bg-cream/70">
              <summary class="flex cursor-pointer items-center justify-between gap-2 text-sm font-semibold text-bark marker:text-sage">
                <span class="truncate"><%= group.name %></span>
                <span class="shrink-0 text-[10px] font-normal text-olive">
                  <%= group.portions.length %> porç<%= group.portions.length === 1 ? 'ão' : 'ões' %>
                </span>
              </summary>
              <% if (group.portions.length) { %>
                <div class="mt-2 flex flex-wrap gap-1">
                  <% group.portions.forEach(function (portion) { %>
                    <span class="rounded-full bg-sand/20 px-2 py-0.5 text-[10px] text-bark ring-1 ring-sand/50"><%= portion %></span>
                  <% }) %>
                </div>
              <% } else { %>
                <p class="mt-2 text-[11px] text-olive">Sem porções cadastradas.</p>
              <% } %>
            </details>
          <% }) %>
        </div>
      </section>

      <div class="grid gap-4 sm:grid-cols-2">
        <section class="rounded-2xl border border-sand/60 bg-cream/60 p-3">
          <div class="flex items-baseline justify-between gap-2">
            <h3 class="text-[10px] font-semibold uppercase tracking-[0.16em] text-olive">Articulações</h3>
            <span class="text-[11px] text-olive"><%= reference.joints.length %></span>
          </div>
          <div class="mt-2 flex flex-wrap gap-1">
            <% reference.joints.forEach(function (joint) { %>
              <span class="rounded-full border border-sand bg-surface px-2 py-0.5 text-[11px] text-bark"><%= joint %></span>
            <% }) %>
            <% if (!reference.joints.length) { %>
              <span class="text-[11px] text-olive">Nenhuma articulação retornada.</span>
            <% } %>
          </div>
        </section>

        <section class="rounded-2xl border border-sand/60 bg-cream/60 p-3">
          <div class="flex items-baseline justify-between gap-2">
            <h3 class="text-[10px] font-semibold uppercase tracking-[0.16em] text-olive">Movimentos</h3>
            <span class="text-[11px] text-olive"><%= reference.movements.length %></span>
          </div>
          <div class="mt-2 flex flex-wrap gap-1">
            <% reference.movements.forEach(function (movement) { %>
              <span class="rounded-full border border-sand bg-surface px-2 py-0.5 text-[11px] text-bark"><%= movement %></span>
            <% }) %>
            <% if (!reference.movements.length) { %>
              <span class="text-[11px] text-olive">Nenhum movimento retornado.</span>
            <% } %>
          </div>
        </section>
      </div>
    </div>
  <% } %>

  <footer class="flex justify-end border-t border-sand/60 bg-cream/80 px-5 py-3">
    <button
      type="button"
      data-modal-close
      class="rounded-xl bg-inverted px-3.5 py-2 text-xs font-semibold text-on-primary ring-1 ring-gold/30 transition hover:bg-bark focus:outline-none focus:ring-2 focus:ring-gold/50"
    >Fechar</button>
  </footer>
</div>
