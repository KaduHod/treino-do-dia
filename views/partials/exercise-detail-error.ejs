<div class="p-5">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-rose-700">Detalhes indisponíveis</p>
      <h2 class="mt-1 font-display text-lg font-semibold leading-snug text-ink">
        Não foi possível carregar o exercício<% if (exerciseId) { %> #<%= exerciseId %><% } %>
      </h2>
    </div>
    <button
      type="button"
      data-modal-close
      class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-bark transition hover:bg-sand/30 hover:text-ink focus:outline-none focus:ring-2 focus:ring-gold/40"
      aria-label="Fechar"
    >✕</button>
  </div>

  <p class="mt-3 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-800"><%= message %></p>

  <div class="mt-4 flex justify-end">
    <button
      type="button"
      data-modal-close
      class="rounded-xl bg-ink px-3.5 py-2 text-xs font-semibold text-cream ring-1 ring-gold/30 transition hover:bg-bark focus:outline-none focus:ring-2 focus:ring-gold/50"
    >Fechar</button>
  </div>
</div>
