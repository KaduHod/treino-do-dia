<form
  id="entry-<%= entry.exerciseId %>"
  class="entry-row flex flex-col gap-3 rounded-2xl border p-3 transition sm:flex-row sm:flex-wrap sm:items-center <%= entry.done ? 'border-sage/70 bg-sage/10' : 'border-sand/80 bg-surface' %>"
  hx-patch="/workouts/<%= view.date %>/entries/<%= entry.exerciseId %>"
  hx-target="this"
  hx-swap="outerHTML"
  hx-trigger="change"
>
  <label class="flex min-w-0 flex-1 cursor-pointer items-start gap-3 sm:min-w-[16rem]">
    <input
      type="checkbox"
      name="done"
      value="true"
      <%= entry.done ? 'checked' : '' %>
      class="mt-0.5 h-5 w-5 shrink-0 cursor-pointer rounded border-sand accent-moss focus:ring-2 focus:ring-gold/40"
    />
    <span class="min-w-0">
      <span class="block text-sm font-semibold leading-snug <%= entry.done ? 'text-ink' : 'text-bark' %>"><%= entry.name %></span>
      <span class="mt-0.5 block text-[11px] text-olive">
        <%= entry.groups.length ? entry.groups.join(' · ') : 'Grupo não informado' %>
        <% if (entry.repInfo) { %>
          · <%= formatNumber(entry.repInfo.totalReps) %> reps
          · <span class="font-semibold text-moss"><%= formatNumber(entry.volume) %> kg</span> de volume
        <% } %>
      </span>
    </span>
  </label>

  <div class="flex items-center gap-2 sm:ml-auto sm:justify-end">
    <label class="flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wide text-olive">
      Reps
      <input
        name="reps"
        type="text"
        value="<%= entry.reps %>"
        placeholder="3x12"
        autocomplete="off"
        maxlength="24"
        class="w-16 rounded-lg border border-sand bg-cream/50 px-2 py-1 text-center text-sm font-semibold text-ink placeholder:text-olive/60 focus:border-gold focus:bg-surface focus:outline-none focus:ring-2 focus:ring-gold/30"
      />
    </label>

    <label class="flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wide text-olive">
      Carga
      <input
        name="weight"
        type="number"
        value="<%= entry.weight %>"
        min="0"
        max="1000"
        step="0.5"
        inputmode="decimal"
        class="w-20 rounded-lg border border-sand bg-cream/50 px-2 py-1 text-center text-sm font-semibold text-ink focus:border-gold focus:bg-surface focus:outline-none focus:ring-2 focus:ring-gold/30"
      />
      <span class="text-[10px] font-normal normal-case text-olive">kg</span>
    </label>

    <button
      type="button"
      class="rounded-lg p-1.5 text-olive transition hover:bg-rose-50 hover:text-rose-600 focus:outline-none focus:ring-2 focus:ring-rose-200"
      hx-delete="/workouts/<%= view.date %>/entries/<%= entry.exerciseId %>"
      hx-target="#day-panel"
      hx-swap="outerHTML"
      hx-confirm="Remover <%= entry.name %> do treino de <%= view.dateLabel %>?"
      title="Remover do treino"
      aria-label="Remover <%= entry.name %> do treino"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
        <path fill-rule="evenodd" d="M8.75 1a1 1 0 0 0-.97.757L7.5 3H4a1 1 0 0 0 0 2h.3l.83 11.24A2 2 0 0 0 7.12 18h5.76a2 2 0 0 0 1.99-1.76L15.7 5h.3a1 1 0 1 0 0-2h-3.5l-.28-1.243A1 1 0 0 0 11.25 1h-2.5Zm1.55 2-.167-.75h-.166L9.8 3h.5ZM7.9 5h4.2l-.78 10.62a.5.5 0 0 1-.5.38H7.18a.5.5 0 0 1-.5-.38L7.9 5Z" clip-rule="evenodd" />
      </svg>
    </button>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <p class="w-full rounded-lg bg-rose-50 px-2 py-1 text-xs font-semibold text-rose-700"><%= error %></p>
  <% } %>
  <% if (typeof justSaved !== 'undefined' && justSaved) { %>
    <span data-saved class="w-full text-right text-[11px] font-semibold text-moss sm:w-auto">Salvo ✓</span>
  <% } %>
</form>
