<section
  id="day-panel"
  data-date="<%= view.date %>"
  class="flex h-full flex-col overflow-hidden rounded-3xl bg-white/90 shadow-card ring-1 ring-sand/80 backdrop-blur"
>
  <header class="flex flex-wrap items-start justify-between gap-3 border-b border-sand/60 bg-gradient-to-br from-cream/90 via-white to-white px-5 py-4">
    <div>
      <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-olive">Treino do dia</p>
      <h2 class="mt-1 font-display text-xl font-semibold leading-snug text-ink"><%= view.dateLabel %></h2>
      <p class="mt-1 text-xs text-olive">Marque o que foi feito e ajuste repetições e carga. Cada alteração é salva na hora.</p>
    </div>
    <% if (view.isToday) { %>
      <span class="rounded-full bg-moss px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-cream ring-1 ring-gold/40">Hoje</span>
    <% } %>
  </header>

  <%- include('day-stats', { view }) %>

  <div class="flex-1 p-5">
    <% if (!view.entries.length) { %>
      <div class="flex h-full min-h-48 flex-col items-center justify-center rounded-2xl border border-dashed border-sand bg-cream/70 p-6 text-center">
        <p class="text-3xl" aria-hidden="true">💪</p>
        <p class="mt-2 font-display text-base font-semibold text-ink">Nenhum exercício registrado neste dia</p>
        <p class="mt-1 max-w-xs text-xs text-olive">Escolha um exercício no catálogo ao lado e clique no botão <span class="font-semibold text-moss">+</span> para começar.</p>
      </div>
    <% } else { %>
      <div class="space-y-2">
        <% view.entries.forEach(function (entry) { %>
          <%- include('entry-row', { view, entry }) %>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
