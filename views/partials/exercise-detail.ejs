<div class="max-h-[85vh] overflow-y-auto">
  <header class="flex items-start justify-between gap-4 border-b border-sand/60 bg-gradient-to-br from-cream/90 via-white to-white p-5">
    <div class="min-w-0">
      <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-olive">Exercício #<%= exercise.id %></p>
      <h2 class="mt-1 font-display text-xl font-semibold leading-snug text-ink"><%= exercise.name %></h2>
      <div class="mt-2 flex flex-wrap items-center gap-1">
        <% exercise.groups.forEach(function (group) { %>
          <span class="rounded-full bg-sage/25 px-2 py-0.5 text-[10px] font-semibold text-moss ring-1 ring-sage/40"><%= group %></span>
        <% }) %>
        <% if (!exercise.groups.length) { %>
          <span class="text-[11px] text-olive">Sem grupo muscular mapeado</span>
        <% } %>
      </div>
    </div>
    <button
      type="button"
      data-modal-close
      class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-bark transition hover:bg-sand/30 hover:text-ink focus:outline-none focus:ring-2 focus:ring-gold/40"
      aria-label="Fechar detalhes"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
        <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
      </svg>
    </button>
  </header>

  <div class="space-y-5 bg-white/70 p-5">
    <% if (exercise.description) { %>
      <div>
        <h3 class="text-[10px] font-semibold uppercase tracking-[0.16em] text-olive">Como executar</h3>
        <p class="mt-1 whitespace-pre-line text-sm leading-relaxed text-bark"><%= exercise.description %></p>
      </div>
    <% } %>

    <div>
      <h3 class="text-[10px] font-semibold uppercase tracking-[0.16em] text-olive">Músculos envolvidos</h3>
      <% if (exercise.mappings.length) { %>
        <div class="mt-2 overflow-hidden rounded-2xl border border-sand/70">
          <table class="min-w-full divide-y divide-sand/50 text-left text-xs">
            <thead class="bg-cream text-[10px] uppercase tracking-wide text-olive">
              <tr>
                <th scope="col" class="px-3 py-2 font-semibold">Grupo</th>
                <th scope="col" class="px-3 py-2 font-semibold">Porção</th>
                <th scope="col" class="px-3 py-2 font-semibold">Articulação</th>
                <th scope="col" class="px-3 py-2 font-semibold">Movimento</th>
                <th scope="col" class="px-3 py-2 font-semibold">Papel</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-sand/40 bg-white">
              <% exercise.mappings.forEach(function (mapping) { %>
                <tr class="align-top transition hover:bg-cream/60">
                  <td class="px-3 py-2 font-semibold text-ink"><%= mapping.muscle_group || '—' %></td>
                  <td class="px-3 py-2 text-bark"><%= mapping.muscle_portion || '—' %></td>
                  <td class="px-3 py-2 text-bark"><%= mapping.joint || '—' %></td>
                  <td class="px-3 py-2 text-bark"><%= mapping.movement || '—' %></td>
                  <td class="px-3 py-2">
                    <span class="rounded-full bg-sand/25 px-2 py-0.5 text-[10px] font-semibold text-bark ring-1 ring-sand/60">
                      <%= roleLabel(mapping.role) %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="mt-1 text-xs text-olive">A API não retornou mapeamentos musculares para este exercício.</p>
      <% } %>
    </div>

    <% if (exercise.info_link) { %>
      <div>
        <h3 class="text-[10px] font-semibold uppercase tracking-[0.16em] text-olive">Referência</h3>
        <a
          href="<%= exercise.info_link %>"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-1 inline-flex break-all text-xs font-semibold text-bark underline decoration-gold decoration-2 underline-offset-2 transition hover:text-moss"
        ><%= exercise.info_link %></a>
      </div>
    <% } %>
  </div>

  <footer class="flex flex-wrap items-center justify-between gap-3 border-t border-sand/60 bg-cream/80 px-5 py-4">
    <p class="text-xs text-olive">
      Dia selecionado: <span class="font-semibold text-ink"><%= view.dateLabel %></span>
    </p>

    <% if (registered) { %>
      <span class="inline-flex items-center gap-1 rounded-xl bg-sage/20 px-3 py-2 text-xs font-semibold text-moss ring-1 ring-sage/50">
        ✓ Já está no treino deste dia
      </span>
    <% } else { %>
      <button
        type="button"
        class="inline-flex items-center gap-2 rounded-xl bg-moss px-3.5 py-2 text-xs font-semibold text-cream shadow-soft ring-1 ring-gold/30 transition hover:bg-bark focus:outline-none focus:ring-2 focus:ring-gold/50"
        hx-post="/workouts/<%= view.date %>/entries"
        hx-vals='{"exerciseId": <%= exercise.id %>}'
        hx-target="#day-panel"
        hx-swap="outerHTML"
        hx-on::after-request="if (event.detail.successful) this.closest('dialog').close()"
      >
        <span aria-hidden="true">+</span> Adicionar ao treino
      </button>
    <% } %>
  </footer>
</div>
