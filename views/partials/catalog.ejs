<section class="flex h-full flex-col overflow-hidden rounded-3xl bg-white/90 shadow-card ring-1 ring-sand/80 backdrop-blur">
  <div class="border-b border-sand/60 bg-gradient-to-br from-white via-white to-cream/80 p-5">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-olive">Biblioteca</p>
        <h2 class="mt-1 font-display text-lg font-semibold leading-snug text-ink">Catálogo de exercícios</h2>
        <p class="mt-1 text-xs text-olive">
          Busca e grupos vêm da API de exercícios. Clique em <span class="font-semibold text-moss">+</span> para registrar no dia.
        </p>
      </div>
      <span
        id="catalog-loading"
        class="htmx-indicator shrink-0 rounded-full bg-gold/15 px-2.5 py-1 text-[11px] font-semibold text-bark ring-1 ring-gold/40"
        role="status"
      >Carregando…</span>
    </div>

    <form id="filter-form" class="mt-4 flex flex-col gap-2 sm:flex-row" onsubmit="return false">
      <div class="relative flex-1">
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sage" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 3.4 9.83l3.13 3.14a.75.75 0 1 0 1.06-1.06l-3.14-3.13A5.5 5.5 0 0 0 9 3.5ZM5 9a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z" clip-rule="evenodd" />
          </svg>
        </span>
        <input
          type="search"
          name="search"
          value="<%= view.filters.search %>"
          placeholder="Buscar por nome, descrição ou músculo"
          autocomplete="off"
          class="w-full rounded-xl border border-sand bg-cream/60 py-2 pl-9 pr-3 text-sm text-ink placeholder:text-olive/60 focus:border-gold focus:bg-white focus:outline-none focus:ring-2 focus:ring-gold/30"
          hx-get="/exercises"
          hx-target="#exercise-list"
          hx-swap="outerHTML"
          hx-trigger="input changed delay:300ms, search"
          hx-include="[name='group']"
          hx-vals='js:{date: document.getElementById("day-date").value}'
          aria-label="Buscar exercícios"
        />
      </div>

      <select
        name="group"
        class="rounded-xl border border-sand bg-cream/60 px-3 py-2 text-sm font-medium text-bark focus:border-gold focus:bg-white focus:outline-none focus:ring-2 focus:ring-gold/30"
        hx-get="/exercises"
        hx-target="#exercise-list"
        hx-swap="outerHTML"
        hx-trigger="change"
        hx-include="[name='search']"
        hx-indicator="#catalog-loading"
        hx-vals='js:{date: document.getElementById("day-date").value}'
        aria-label="Filtrar por grupo muscular"
      >
        <option value="">Todos os grupos</option>
        <% view.groups.forEach(function (group) { %>
          <option value="<%= group %>" <%= view.filters.group === group ? 'selected' : '' %>><%= group %></option>
        <% }) %>
      </select>
    </form>
  </div>

  <%- include('exercise-list', { view }) %>
</section>
